# Cadena de conexión a Postgres. Funciona igual con un Postgres local,
# Docker, o uno administrado (Railway, Render, Supabase, Neon, etc.) —
# solo cambia esta URL, el código no depende de dónde esté hospedado.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_pizzas?schema=public"

# Secreto para firmar los JWT de sesión. Genera uno propio en producción,
# por ejemplo con: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto en el que corre la API.
PORT=4000

# Origen permitido para CORS (la URL donde corre el frontend).
CORS_ORIGIN="http://localhost:5173"
